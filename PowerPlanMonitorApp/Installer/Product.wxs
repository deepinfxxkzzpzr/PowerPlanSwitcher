<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- UpgradeCode 沿用历史安装包（dist 中 1.0.11 版），不可更改，否则老用户无法原地升级 -->
  <Package Name="PowerPlanMonitor"
           Manufacturer="PowerPlanMonitor"
           Version="1.0.25"
           Language="2052"
           Codepage="65001"
           UpgradeCode="E12EC334-3EB9-4F8E-9B3A-574FB7BB7E0B"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="已安装更高版本的 PowerPlanMonitor，无法降级安装。" />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="..\PowerPlanMonitor.App\Assets\AppIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="PowerPlanMonitor">
        <Component Id="MainExe">
          <File Id="MainExeFile"
                Source="..\..\publish\PowerPlanMonitor\PowerPlanMonitor.exe"
                KeyPath="yes">
            <!-- 非广告式快捷方式直接指向 exe，才能显示 UAC 盾牌图标 -->
            <Shortcut Id="StartMenuShortcut"
                      Directory="ProgramMenuFolder"
                      Name="PowerPlanMonitor"
                      WorkingDirectory="INSTALLFOLDER"
                      Advertise="no" />
            <Shortcut Id="DesktopShortcut"
                      Directory="DesktopFolder"
                      Name="PowerPlanMonitor"
                      WorkingDirectory="INSTALLFOLDER"
                      Advertise="no" />
          </File>
        </Component>
        <Component Id="PawnIoSetup">
          <File Id="PawnIoSetupFile"
                Source="..\..\publish\PowerPlanMonitor\PawnIO_Setup.exe"
                KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
  </Package>
</Wix>
