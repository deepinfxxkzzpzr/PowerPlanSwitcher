<Window x:Class="PowerPlanMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="572" Height="260" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent" Topmost="True"
        ShowInTaskbar="False">
    <Window.Resources>
        <SolidColorBrush x:Key="ModePanelBrush" Color="#EA101821"/>
        <SolidColorBrush x:Key="ModeHoverBrush" Color="#F0162430"/>
        <SolidColorBrush x:Key="ModeBorderBrush" Color="#4A38BDF8"/>

        <Style x:Key="ModeListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#EAF2F8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#26384A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#334155"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="218"/>
            <Setter Property="MaxWidth" Value="304"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Black"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="ButtonChrome"
                                    CornerRadius="17"
                                    Background="{StaticResource ModePanelBrush}"
                                    BorderBrush="{StaticResource ModeBorderBrush}"
                                    BorderThickness="1">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.18" Color="#000000"/>
                                </Border.Effect>
                            </Border>
                            <ContentPresenter Margin="14,0,42,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              RecognizesAccessKey="True"/>
                            <Path Data="M 0 0 L 5 5 L 10 0"
                                  Stroke="#9DEDE1"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,2,15,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource ModeHoverBrush}"/>
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#7067E8F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GaugeCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Background" Value="#14000000"/>
            <Setter Property="BorderBrush" Value="#0E7DD3FC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="GaugeRoot" Width="572" Height="260" RenderTransformOrigin="0,0">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="GaugeScale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>

        <Border x:Name="ShellBorder" Margin="7" CornerRadius="32" Padding="18,15" BorderThickness="1.2" BorderBrush="#2B67E8F9">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="BackgroundStopA" Color="#F20A1D28" Offset="0"/>
                    <GradientStop x:Name="BackgroundStopB" Color="#F4142332" Offset="0.54"/>
                    <GradientStop x:Name="BackgroundStopC" Color="#F5080D14" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect x:Name="ShellGlow" BlurRadius="18" ShadowDepth="0" Opacity="0.26" Color="#115EEAD4"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="36"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlanButton"
                            Style="{StaticResource ModeButton}"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="MODE" Foreground="#8EA2B3" FontSize="10" FontWeight="Black" Margin="0,1,9,0"/>
                            <TextBlock x:Name="PlanNameText" Text="电源模式" Foreground="#F8FAFC" FontSize="12" FontWeight="Black"/>
                        </StackPanel>
                    </Button>
                    <Popup x:Name="PlanPopup"
                           PlacementTarget="{Binding ElementName=PlanButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border CornerRadius="18"
                                Background="#F20B1118"
                                BorderBrush="#5067E8F9"
                                BorderThickness="1"
                                Padding="8"
                                MinWidth="238"
                                Margin="0,7,0,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="26" ShadowDepth="8" Opacity="0.42" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="选择电源模式" Foreground="#8392A3" FontSize="10" FontWeight="Black" Margin="7,2,7,6"/>
                                <ListBox x:Name="PlanList"
                                         ItemContainerStyle="{StaticResource ModeListItem}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         MaxHeight="220"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Border Grid.Column="1" CornerRadius="17" Padding="14,0" Height="34" VerticalAlignment="Center"
                            Background="#BB1C251F" BorderBrush="#366AF7C7" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#8BF6C5" Margin="0,0,7,0"/>
                            <TextBlock x:Name="PowerStateText" Text="POWER IN" Foreground="#C8FACC"
                                       FontSize="11" FontWeight="Black" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource GaugeCard}" HorizontalAlignment="Stretch">
                        <Grid x:Name="CpuGauge" Width="244" Height="144" HorizontalAlignment="Center">
                            <TextBlock Text="CPU" Foreground="#F3F7FB" FontSize="15" FontWeight="Black"
                                       HorizontalAlignment="Center" Margin="0,1,0,0"/>
                            <Border CornerRadius="13" Background="#52090F16" Padding="10,2"
                                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="CpuPercentText" Text="--%" Foreground="#F8FAFC"
                                               FontSize="24" FontWeight="Black" HorizontalAlignment="Center" LineHeight="25"/>
                                    <TextBlock x:Name="CpuFrequencyText" Text="--GHz" Foreground="#C9D6E2"
                                               FontSize="11" FontWeight="Black" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Canvas Width="210" Height="138" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                <Path x:Name="CpuTrack" Stroke="#24FFFFFF" StrokeThickness="14"
                                      StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"/>
                                <Path x:Name="CpuArc" Stroke="#5EEAD4" StrokeThickness="14"
                                      StrokeStartLineCap="Flat" StrokeEndLineCap="Flat">
                                    <Path.Effect>
                                        <DropShadowEffect x:Name="CpuArcGlow" BlurRadius="8" ShadowDepth="0" Opacity="0.28" Color="#5EEAD4"/>
                                    </Path.Effect>
                                </Path>
                                <Path x:Name="CpuArcMarker" Stroke="#F8FAFC" StrokeThickness="2.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.96"/>
                            </Canvas>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource GaugeCard}" HorizontalAlignment="Stretch">
                        <Grid x:Name="MemoryGauge" Width="244" Height="144" HorizontalAlignment="Center">
                            <TextBlock Text="RAM" Foreground="#F3F7FB" FontSize="15" FontWeight="Black"
                                       HorizontalAlignment="Center" Margin="0,1,0,0"/>
                            <Border CornerRadius="13" Background="#52090F16" Padding="10,2"
                                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,48,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="MemoryPercentText" Text="--%" Foreground="#F8FAFC"
                                               FontSize="24" FontWeight="Black" HorizontalAlignment="Center" LineHeight="25"/>
                                    <TextBlock x:Name="MemoryFreeText" Text="--GB" Foreground="#C9D6E2"
                                               FontSize="11" FontWeight="Black" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Canvas Width="210" Height="138" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                <Path x:Name="MemoryTrack" Stroke="#24FFFFFF" StrokeThickness="14"
                                      StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"/>
                                <Path x:Name="MemoryArc" Stroke="#38BDF8" StrokeThickness="14"
                                      StrokeStartLineCap="Flat" StrokeEndLineCap="Flat">
                                    <Path.Effect>
                                        <DropShadowEffect x:Name="MemoryArcGlow" BlurRadius="8" ShadowDepth="0" Opacity="0.28" Color="#38BDF8"/>
                                    </Path.Effect>
                                </Path>
                                <Path x:Name="MemoryArcMarker" Stroke="#F8FAFC" StrokeThickness="2.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Opacity="0.96"/>
                            </Canvas>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="18" Background="#9A111820" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="12,0" Height="32">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="TEMP" Foreground="#8392A3" FontSize="10" FontWeight="Black" Margin="0,0,8,0"/>
                            <TextBlock x:Name="TemperatureText" Text="--°C" Foreground="#A7F3D0"
                                       FontSize="17" FontWeight="Black" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" CornerRadius="18" Background="#9A111820" BorderBrush="#24FFFFFF" BorderThickness="1" Padding="12,0" Height="32">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="NET" Foreground="#8392A3" FontSize="10" FontWeight="Black" Margin="0,0,8,0"/>
                            <TextBlock x:Name="NetworkText" Text="↑ --B/s   ↓ --B/s"
                                       Foreground="#A7F3D0" FontSize="15" FontWeight="Black" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="DockedRoot"
              Width="24"
              Height="86"
              Visibility="Collapsed"
              MouseLeftButtonDown="OnDockedMouseLeftButtonDown"
              MouseMove="OnDockedMouseMove"
              MouseLeftButtonUp="OnDockedMouseLeftButtonUp">
            <Border CornerRadius="8"
                    Background="#B4121A22"
                    BorderBrush="#2F8FA1AD"
                    BorderThickness="1"
                    Padding="3">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.20" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7"/>
                        <ColumnDefinition Width="2"/>
                        <ColumnDefinition Width="7"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="4" Background="#6EADB5BC" BorderBrush="#52E5EDF2" BorderThickness="1">
                        <Grid Margin="1">
                            <Border CornerRadius="3" Background="#1CFFFFFF"/>
                            <Border x:Name="CpuStripFill"
                                    CornerRadius="3"
                                    Background="#5EEAD4"
                                    Height="0"
                                    VerticalAlignment="Bottom">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.36" Color="#5EEAD4"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" CornerRadius="4" Background="#6EADB5BC" BorderBrush="#52E5EDF2" BorderThickness="1">
                        <Grid Margin="1">
                            <Border CornerRadius="3" Background="#1CFFFFFF"/>
                            <Border x:Name="MemoryStripFill"
                                    CornerRadius="3"
                                    Background="#38BDF8"
                                    Height="0"
                                    VerticalAlignment="Bottom">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.36" Color="#38BDF8"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
