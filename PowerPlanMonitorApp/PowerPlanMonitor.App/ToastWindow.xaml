<Window x:Class="PowerPlanMonitor.App.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="320" Height="78" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False">
    <Border CornerRadius="18" Background="#F21B1F24" BorderBrush="#52FFFFFF" BorderThickness="1" Padding="18,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.32" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="电源模式已切换" Foreground="#9CA3AF" FontSize="12"/>
            <TextBlock x:Name="MessageText" Text="" Foreground="#F8FAFC" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/>
        </StackPanel>
    </Border>
</Window>
